# Reviewed source, guides and reference inputs.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CITATION.cff
!/requirements*.txt
!/pyproject.toml
!/.env.example
!/docs/
!/analysis/
!/training/
!/results/
/results/*
!/results/knowledge/
/results/knowledge/*
!/results/knowledge/english_guidelines.json
!/examples/
!/conftest.py
!/pytest.ini
!/src/
!/tests/
!/config/
!/prompts/
!/scripts/
!/data/
!/deploy/
!/experiments/

# The loaders need these small, authored label mappings. Dataset texts stay local.
/data/*
!/data/mappings/
!/data/evaluations/
/data/evaluations/*
!/data/evaluations/english_guidelines.json
/data/mappings/*
!/data/mappings/detox_targets.csv
!/data/mappings/hatexplain_targets.csv
!/data/mappings/implicit_hate_types.csv
!/data/mappings/mhs_thresholds.md

# Original training settings and dependency pins.
/deploy/*
!/deploy/README.md
!/deploy/environment/
!/deploy/full_training/
!/deploy/type_update/
/deploy/*/data/*
!/deploy/*/data/configs.json

# Frozen study plans and compact numerical summaries. Per-item results,
# annotated responses, server receipts and generated inputs stay in the archive.
/experiments/*
!/experiments/manifests/
!/experiments/results/
!/experiments/astra/
/experiments/manifests/*
!/experiments/manifests/*.yaml
/experiments/results/*
!/experiments/results/*.metrics.json
/experiments/astra/*
!/experiments/astra/*/
/experiments/astra/*/*
!/experiments/astra/*/plan.json
!/experiments/astra/*/protocol.json
!/experiments/astra/*/scientific_plan.json
!/experiments/astra/*/scientific_plan_v*.json
!/experiments/astra/*/STUDY_PROTOCOL.md
!/experiments/astra/sq1_full_kb_guideline_oracle_20260925_v1/analysis_results_v1/
/experiments/astra/sq1_full_kb_guideline_oracle_20260925_v1/analysis_results_v1/*
!/experiments/astra/sq1_full_kb_guideline_oracle_20260925_v1/analysis_results_v1/gate_matrix.json
!/experiments/astra/sq2_combined_final_20261104_v1/publication_tables.json
!/experiments/astra/sq2_combined_final_20261104_v1/figure_values.json
!/experiments/astra/sq3_final_synthesis_20261027_v1/display_tables.md
!/experiments/astra/sq3_final_synthesis_20261027_v1/figure_data.json

